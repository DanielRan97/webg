// WEBG database schema.
// Written to be provider-agnostic: no enums, no Json columns, no native types.
// Status-like fields are plain strings whose allowed values live in src/lib/constants.ts.
// PostgreSQL (Neon): DATABASE_URL is the pooled connection used at runtime by
// Prisma Client; DIRECT_URL is the direct connection Prisma Migrate uses.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  /**
   * Set once the owner confirms their email. Publishing a new site requires this.
   */
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  websites        Website[]
  sessions        Session[]
  tokens          VerificationToken[]
  supportTickets  SupportTicket[]
}

/**
 * A logged-in session. The cookie holds only an opaque random token; we store
 * a hash of it here so a database leak never yields a usable session. Deleting
 * a row here immediately signs that session out, everywhere.
 */
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Single-use, expiring tokens for password reset and email verification.
 * Only the hash is stored, never the raw token. `purpose` is one of the
 * values in src/lib/constants.ts (TOKEN_PURPOSE).
 */
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/**
 * One row per attempt at a rate-limited action (login, signup, password
 * reset...). `key` combines the action with an identifier (IP or email).
 * Rows older than the window are ignored and pruned opportunistically.
 */
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Website {
  id                 String   @id @default(cuid())
  userId             String
  businessName       String
  slug               String   @unique
  category           String
  description        String?
  primaryColor       String   @default("#2563eb")
  secondaryColor     String?
  logoUrl            String?
  heroImageUrl       String?
  templateId         String   @default("modern")
  /// Top-bar arrangement ("logo:start,name:start,menu:end"); null = the template's own default. See src/lib/nav-layout.ts.
  navLayout          String?
  status             String   @default("DRAFT") // DRAFT | PUBLISHED
  subscriptionStatus String   @default("TRIAL") // ACTIVE | PAST_DUE | INACTIVE | TRIAL (cache of Subscription.status)
  plan               String   @default("BASIC") // BASIC | PRO
  /**
   * Pro only: where new inquiries go - BOTH (email + inquiries center), EMAIL (center switched off) or
   * CENTER (no emails). Basic sites always get email. Inquiries are saved either way.
   */
  inquiryDelivery    String   @default("BOTH")
  /**
   * Non-null while the owner is still walking through the first-time wizard
   * (holds the id of the step they were last on, e.g. "basics") - null once
   * the wizard has been completed at least once, after which the site opens
   * in the full free-edit UI instead. Existing sites (created before this
   * column existed) are null, so they are unaffected.
   */
  wizardStep         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile        BusinessProfile?
  services       Service[]
  hours          BusinessHour[]
  holidayHours   HolidayHour[]
  contactChecks  ContactVerification[]
  gallery        GalleryImage[]
  socials        SocialLink[]
  sections       WebsiteSection[]
  subscription   Subscription?
  testimonials   Testimonial[]
  areas          ServiceArea[]
  faqItems       FaqItem[]
  highlights     Highlight[]
  experience     Experience[]
  education      Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  interactions   CustomerInteraction[]
  pageViews      PageView[]
  payments       Payment[]

  @@index([userId])
}

model BusinessProfile {
  websiteId    String  @id
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  ctaType      String  @default("WHATSAPP") // CALL | WHATSAPP | BOOKING | MESSAGE
  openSaturday Boolean @default(false)
  openHolidays Boolean @default(false)
  /**
   * What the services/menu list holds, for its wording on the site and in the form: DISHES | PRODUCTS | SERVICES.
   */
  itemKind     String  @default("DISHES")
  /**
   * Short subtitle/role shown under the name in the hero, e.g. "מפתחת Full-Stack". Optional, any category.
   */
  subtitle     String?
  /**
   * Optional CV/resume download link, shown as a button in the contact section when set.
   */
  resumeUrl    String?

  // Emergency availability
  emergency24x7    Boolean @default(false)
  emergencyPhone   String?
  emergencyMessage String?

  // Booking button (not a booking system): WHATSAPP | PHONE | LINK
  bookingMethod String  @default("WHATSAPP")
  bookingUrl    String?
  bookingText   String?

  // Delivery info (informational only - no checkout, no tracking, no address collection).
  deliveryAvailable Boolean @default(false)
  deliveryAreas     String?
  deliveryMinOrder  String?
  deliveryFee       String?
  deliveryFreeOver  String?
  deliveryTime      String?
  deliveryNote      String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Service {
  id          String  @id @default(cuid())
  websiteId   String
  name        String
  description String?
  price       String?
  category    String? // optional group, e.g. "Starters" (used by menu, price list and services)
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model BusinessHour {
  id        String  @id @default(cuid())
  websiteId String
  day       Int // 0 = Sunday ... 6 = Saturday
  isOpen    Boolean @default(true)
  openTime  String? // "09:00"
  closeTime String? // "18:00"

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, day])
}

/**
 * Opening hours for a specific holiday (e.g. "ערב ראש השנה"), shown under the weekly hours. The date is
 * optional free choice of the owner; closed by default.
 */
model HolidayHour {
  id        String  @id @default(cuid())
  websiteId String
  name      String
  date      String? // "2026-09-11"
  isOpen    Boolean @default(false)
  openTime  String?
  closeTime String?
  order     Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model GalleryImage {
  id          String  @id @default(cuid())
  websiteId   String
  url         String
  /**
   * Every field below is optional: a plain image with none of them behaves exactly like before.
   */
  title       String?
  description String?
  price       String? // free text, e.g. "120 ₪", "החל מ-250 ₪", "לפי הצעת מחיר"
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model SocialLink {
  id        String @id @default(cuid())
  websiteId String
  platform  String // instagram | facebook | tiktok
  url       String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, platform])
}

model WebsiteSection {
  id        String  @id @default(cuid())
  websiteId String
  type      String
  enabled   Boolean @default(true)
  order     Int

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, type])
}

/**
 * A site's billing (see src/server/billing.ts). WEBG runs the monthly cycle itself: the first payment goes
 * through HYP's payment page, which leaves a card token; on `currentPeriodEnd` the daily job charges that
 * token. A failed charge makes the site PAST_DUE (still shown) for a 7-day grace; after it, INACTIVE.
 */
model Subscription {
  id                String    @id @default(cuid())
  websiteId         String    @unique
  status            String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | INACTIVE (cached on Website.subscriptionStatus)
  /// When the paid (or free) period ends - the next charge is due then.
  currentPeriodEnd  DateTime?
  provider          String? // "HYP" once a card is on file
  providerRef       String?
  /// HYP's card token (19 digits, useless outside WEBG's terminal - never the card number) and its expiry (YYMM).
  cardToken         String?
  cardExpiry        String?
  cardLast4         String?
  /// Failed renewal attempts in the current grace period, and when that period began.
  failedAttempts    Int       @default(0)
  pastDueSince      DateTime?
  /// The owner cancelled: no further charges, the site stays live until currentPeriodEnd.
  cancelAtPeriodEnd Boolean   @default(false)
  /// When the "billing starts" / "card needed soon" reminders were last sent (TRIAL sites with no card).
  remindedAt        DateTime?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}

/**
 * One payment attempt: a checkout through HYP's payment page (PENDING until the owner comes back and the
 * redirect is verified) or a renewal charge of the stored token. Kept when the site is deleted (websiteId
 * becomes null) - it is the record of money taken. Amounts in agorot.
 */
model Payment {
  id              String    @id @default(cuid())
  websiteId       String?
  userId          String
  /// CHECKOUT (payment page: first payment, upgrade, or paying an overdue month with a new card) | RENEWAL
  kind            String
  /// What the payment is for once it succeeds: PUBLISH | UPGRADE | CARD (renew with a new card) | RENEWAL
  purpose         String
  plan            String // BASIC | PRO
  amountAgorot    Int
  status          String    @default("PENDING") // PENDING | PAID | FAILED
  /// HYP's transaction id (`Id`) and status code (`CCode`).
  providerTransId String?
  providerCode    String?
  /// The business name when paid, for the record.
  description     String
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([websiteId, createdAt])
  @@index([status, createdAt])
}

model Testimonial {
  id        String  @id @default(cuid())
  websiteId String
  name      String
  text      String
  rating    Int? // 1-5, optional
  imageUrl  String?
  order     Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model ServiceArea {
  id        String @id @default(cuid())
  websiteId String
  name      String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model FaqItem {
  id        String @id @default(cuid())
  websiteId String
  question  String
  answer    String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model Highlight {
  id        String @id @default(cuid())
  websiteId String
  label     String
  value     String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a work history entry.
 */
model Experience {
  id           String  @id @default(cuid())
  websiteId    String
  organization String
  role         String
  startDate    String?
  endDate      String? // empty/null is rendered as "היום" (Present)
  description  String?
  order        Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a degree/course entry.
 */
model Education {
  id          String  @id @default(cuid())
  websiteId   String
  institution String
  field       String?
  dates       String?
  description String?
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a single skill tag.
 */
model Skill {
  id        String @id @default(cuid())
  websiteId String
  name      String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a project/work sample. Deliberately has no price field.
 */
model Project {
  id          String  @id @default(cuid())
  websiteId   String
  title       String
  description String?
  imageUrl    String?
  link        String?
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a certification or completed course.
 */
model Certification {
  id        String  @id @default(cuid())
  websiteId String
  name      String
  issuer    String?
  date      String?
  link      String?
  order     Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * One row per customer-initiated interaction from a website's public pages
 * (contact form, lead form, and future forms such as native booking
 * requests) - the single place an owner checks instead of searching their
 * email inbox. `type` is a plain string (see INTERACTION_TYPES in
 * src/lib/constants.ts), matching this schema's provider-agnostic
 * convention. `metadata` is JSON-encoded text for the same reason (no
 * native Json column) - free-form extra context such as which section
 * produced the interaction.
 */
model CustomerInteraction {
  id        String    @id @default(cuid())
  websiteId String
  type      String // CONTACT_MESSAGE | LEAD | BOOKING | CALLBACK | OTHER
  name      String?
  phone     String?
  email     String?
  message   String?
  metadata  String?
  createdAt DateTime  @default(now())
  seenAt    DateTime?
  status    String    @default("OPEN") // OPEN | IN_PROGRESS | CLOSED - the owner's own follow-up, see INTERACTION_STATUS

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([websiteId, seenAt])
}

/**
 * One row per website per day - a lightweight aggregate visit counter, not
 * one row per view. Written only from the public /s/[slug] page (see
 * src/server/traffic.ts); nothing else on the platform can reach that code
 * path, so no visitor identifier (IP, cookie, fingerprint) is needed or
 * stored here at all.
 */
model PageView {
  id        String   @id @default(cuid())
  websiteId String
  day       DateTime // truncated to UTC midnight
  count     Int      @default(1)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, day])
  @@index([websiteId])
}

/**
 * A WEBG customer's support ticket to the WEBG platform team - distinct from
 * CustomerInteraction, which is an end-visitor contacting a business through
 * its own published site. `relatedWebsiteId` is a plain unenforced reference
 * (no FK/relation): a ticket should survive its related site being deleted,
 * and ownership of it is re-validated server-side on every write anyway, so
 * a DB-level relation would add nothing but a cascade to guard against.
 * `adminSeenAt`/`userSeenAt` are each side's own "last viewed this thread"
 * timestamp; unread-for-admin means the latest message is from the user and
 * is newer than adminSeenAt (same idea, mirrored, for unread-for-user) - no
 * separate read-state table needed for this MVP.
 */
model SupportTicket {
  id               String    @id @default(cuid())
  userId           String
  category         String // ISSUE | QUESTION | SUGGESTION | ACCOUNT | OTHER
  subject          String
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  relatedWebsiteId String?
  adminSeenAt      DateTime?
  userSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  closedAt         DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([status])
}

/**
 * One row per message in a ticket's thread, from either side - a single
 * shared table (not separate user/admin tables) since a thread is just a
 * time-ordered list of messages regardless of sender.
 */
model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderType String // USER | ADMIN
  message    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/**
 * A contact detail shown on a site (its email, or a phone/WhatsApp number) and whether the owner proved
 * it is theirs with a one-time code. One row per site + kind + value; only the code's hash is stored.
 * A number used for both phone and WhatsApp is verified once.
 */
model ContactVerification {
  id         String    @id @default(cuid())
  websiteId  String
  kind       String // EMAIL | PHONE
  value      String // normalized: lowercased email, or the phone's digits starting with 0
  codeHash   String?
  expiresAt  DateTime?
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, kind, value])
}
