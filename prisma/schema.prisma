// WEBG database schema.
// Written to be provider-agnostic: no enums, no Json columns, no native types.
// Status-like fields are plain strings whose allowed values live in src/lib/constants.ts.
// PostgreSQL (Neon): DATABASE_URL is the pooled connection used at runtime by
// Prisma Client; DIRECT_URL is the direct connection Prisma Migrate uses.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  /**
   * Set once the owner confirms their email. Publishing a new site requires this.
   */
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  websites        Website[]
  sessions        Session[]
  tokens          VerificationToken[]
}

/**
 * A logged-in session. The cookie holds only an opaque random token; we store
 * a hash of it here so a database leak never yields a usable session. Deleting
 * a row here immediately signs that session out, everywhere.
 */
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Single-use, expiring tokens for password reset and email verification.
 * Only the hash is stored, never the raw token. `purpose` is one of the
 * values in src/lib/constants.ts (TOKEN_PURPOSE).
 */
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/**
 * One row per attempt at a rate-limited action (login, signup, password
 * reset...). `key` combines the action with an identifier (IP or email).
 * Rows older than the window are ignored and pruned opportunistically.
 */
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Website {
  id                 String   @id @default(cuid())
  userId             String
  businessName       String
  slug               String   @unique
  category           String
  description        String?
  primaryColor       String   @default("#2563eb")
  secondaryColor     String?
  logoUrl            String?
  heroImageUrl       String?
  templateId         String   @default("modern")
  status             String   @default("DRAFT") // DRAFT | PUBLISHED
  subscriptionStatus String   @default("TRIAL") // ACTIVE | INACTIVE | TRIAL (cache of Subscription.status)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile        BusinessProfile?
  services       Service[]
  hours          BusinessHour[]
  gallery        GalleryImage[]
  socials        SocialLink[]
  sections       WebsiteSection[]
  subscription   Subscription?
  testimonials   Testimonial[]
  areas          ServiceArea[]
  faqItems       FaqItem[]
  highlights     Highlight[]
  experience     Experience[]
  education      Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]

  @@index([userId])
}

model BusinessProfile {
  websiteId    String  @id
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  city         String?
  ctaType      String  @default("WHATSAPP") // CALL | WHATSAPP | BOOKING | MESSAGE
  openSaturday Boolean @default(false)
  openHolidays Boolean @default(false)
  /**
   * Short subtitle/role shown under the name in the hero, e.g. "מפתחת Full-Stack". Optional, any category.
   */
  subtitle     String?
  /**
   * Optional CV/resume download link, shown as a button in the contact section when set.
   */
  resumeUrl    String?

  // Emergency availability
  emergency24x7    Boolean @default(false)
  emergencyPhone   String?
  emergencyMessage String?

  // Booking button (not a booking system): WHATSAPP | PHONE | LINK
  bookingMethod String  @default("WHATSAPP")
  bookingUrl    String?
  bookingText   String?

  // Delivery info (informational only - no checkout, no tracking, no address collection).
  deliveryAvailable Boolean @default(false)
  deliveryAreas     String?
  deliveryMinOrder  String?
  deliveryFee       String?
  deliveryFreeOver  String?
  deliveryTime      String?
  deliveryNote      String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Service {
  id          String  @id @default(cuid())
  websiteId   String
  name        String
  description String?
  price       String?
  category    String? // optional group, e.g. "Starters" (used by menu, price list and services)
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model BusinessHour {
  id        String  @id @default(cuid())
  websiteId String
  day       Int // 0 = Sunday ... 6 = Saturday
  isOpen    Boolean @default(true)
  openTime  String? // "09:00"
  closeTime String? // "18:00"

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, day])
}

model GalleryImage {
  id          String  @id @default(cuid())
  websiteId   String
  url         String
  /**
   * Every field below is optional: a plain image with none of them behaves exactly like before.
   */
  title       String?
  description String?
  price       String? // free text, e.g. "120 ₪", "החל מ-250 ₪", "לפי הצעת מחיר"
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model SocialLink {
  id        String @id @default(cuid())
  websiteId String
  platform  String // instagram | facebook | tiktok
  url       String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, platform])
}

model WebsiteSection {
  id        String  @id @default(cuid())
  websiteId String
  type      String
  enabled   Boolean @default(true)
  order     Int

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, type])
}

model Subscription {
  id               String    @id @default(cuid())
  websiteId        String    @unique
  status           String    @default("TRIAL") // ACTIVE | INACTIVE | TRIAL
  currentPeriodEnd DateTime?
  provider         String? // reserved for Phase 3 payments
  providerRef      String?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id        String  @id @default(cuid())
  websiteId String
  name      String
  text      String
  rating    Int? // 1-5, optional
  imageUrl  String?
  order     Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model ServiceArea {
  id        String @id @default(cuid())
  websiteId String
  name      String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model FaqItem {
  id        String @id @default(cuid())
  websiteId String
  question  String
  answer    String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model Highlight {
  id        String @id @default(cuid())
  websiteId String
  label     String
  value     String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a work history entry.
 */
model Experience {
  id           String  @id @default(cuid())
  websiteId    String
  organization String
  role         String
  startDate    String?
  endDate      String? // empty/null is rendered as "היום" (Present)
  description  String?
  order        Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a degree/course entry.
 */
model Education {
  id          String  @id @default(cuid())
  websiteId   String
  institution String
  field       String?
  dates       String?
  description String?
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a single skill tag.
 */
model Skill {
  id        String @id @default(cuid())
  websiteId String
  name      String
  order     Int    @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a project/work sample. Deliberately has no price field.
 */
model Project {
  id          String  @id @default(cuid())
  websiteId   String
  title       String
  description String?
  imageUrl    String?
  link        String?
  order       Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

/**
 * Portfolio category: a certification or completed course.
 */
model Certification {
  id        String  @id @default(cuid())
  websiteId String
  name      String
  issuer    String?
  date      String?
  link      String?
  order     Int     @default(0)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}
